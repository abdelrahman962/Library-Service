# Local secret this service checks on every request (X-Api-Secret header).
PYTHON_AGENT_SECRET=vehicle-ai-local-secret

# Ollama endpoint and model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Tool calling needs enough context for its tool schemas, conversation
# context, and the actual Pitstrack result.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=10m

# In-memory (and disk-persisted) messages retained per user (four
# user/assistant turns).
AGENT_MEMORY_MESSAGES=8
AGENT_MEMORY_FILE=storage/conversation_memory.json
AGENT_DATA_ANSWER_CACHE_SECONDS=45
AGENT_MEMORY_SAVE_INTERVAL_SECONDS=3
PITSTRACK_VEHICLES_CACHE_SECONDS=60

# Pitstrack fleet-tracking API (used by get_vehicles / get_working_hours).
# Get PITSTRACK_TOKEN from Pitstrack (test it in Postman first); without it,
# vehicle/fleet questions will fail with "data source unavailable".
PITSTRACK_BASE_URL=https://tracking.dev.pitstrack.com
PITSTRACK_TOKEN=
PITSTRACK_ACCOUNT_ID=142
